# Copy to .env and fill in what you need. Never commit .env.

# --- LLM fallback chain (config/llm.yaml). Providers without a key are skipped; the deterministic mock is last. ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Local, offline LLM via Ollama (http://localhost:11434). Set to true to try it in the chain.
OLLAMA_ENABLED=false
# Force the deterministic mock LLM (tests always force this).
MOCK_LLM=false

# --- Demo pacing: seconds each agent step is held so the UI can animate (0 for instant). ---
STEP_DELAY_S=1.0

# --- Real adapters (all disabled + read-only by default in config/adapters.yaml) ---
GITHUB_TOKEN=
KUBE_TOKEN=

# --- Paths (defaults are fine) ---
# DB_PATH=./data/devops_agents.db
# SEED_HISTORY=true
