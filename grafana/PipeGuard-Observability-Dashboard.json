{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "PipeGuard Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "PipeGuard Loki datasource",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" },
    { "type": "panel", "id": "text", "name": "Text", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Jenkins pipeline health, Vagrant host capacity, and build logs collected through PipeGuard Alloy.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Online", "color": "green" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "editorMode": "code", "expr": "up{job=\"jenkins\"}", "legendFormat": "Jenkins", "range": true, "refId": "A" }],
      "title": "Jenkins connection",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "editorMode": "code", "expr": "count(default_jenkins_builds_available_builds_count)", "legendFormat": "Jobs", "range": true, "refId": "A" }],
      "title": "Monitored jobs",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "editorMode": "code", "expr": "sum(default_jenkins_executors_busy)", "legendFormat": "Busy executors", "range": true, "refId": "A" }],
      "title": "Busy executors",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "editorMode": "code", "expr": "avg(default_jenkins_builds_health_score)", "legendFormat": "Average health score", "range": true, "refId": "A" }],
      "title": "Average job health",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisLabel": "Health score", "drawStyle": "bars", "fillOpacity": 75, "lineWidth": 1, "showPoints": "never" }, "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "editorMode": "code", "expr": "default_jenkins_builds_health_score", "legendFormat": "{{jenkins_job}}", "range": true, "refId": "A" }],
      "title": "Jenkins job health by pipeline",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisLabel": "Seconds", "drawStyle": "bars", "fillOpacity": 75, "lineWidth": 1, "showPoints": "never" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "editorMode": "code", "expr": "default_jenkins_builds_last_build_duration_milliseconds / 1000", "legendFormat": "{{jenkins_job}}", "range": true, "refId": "A" }],
      "title": "Latest build duration by pipeline",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "text": "Success", "color": "green" }, "1": { "text": "Unstable", "color": "yellow" }, "2": { "text": "Failure", "color": "red" }, "3": { "text": "Not built", "color": "gray" }, "4": { "text": "Aborted", "color": "orange" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "options": { "cellHeight": "sm", "showHeader": true },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "editorMode": "code", "expr": "default_jenkins_builds_last_build_result_ordinal", "format": "table", "instant": true, "legendFormat": "{{jenkins_job}}", "range": false, "refId": "A" }],
      "title": "Latest build result by pipeline",
      "type": "table"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisLabel": "CPU busy", "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "editorMode": "code", "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node_exporter\",mode=\"idle\"}[5m])))", "legendFormat": "{{instance}}", "range": true, "refId": "A" }],
      "title": "Vagrant host CPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 9,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "editorMode": "code", "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node_exporter\"} / node_memory_MemTotal_bytes{job=\"node_exporter\"})", "legendFormat": "Memory used", "range": true, "refId": "A" }],
      "title": "Vagrant host memory used",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 10,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_PROMETHEUS}", "editorMode": "code", "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node_exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"node_exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})", "legendFormat": "Root filesystem used", "range": true, "refId": "A" }],
      "title": "Vagrant root filesystem used",
      "type": "stat"
    },
    {
      "datasource": "${DS_LOKI}",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 30 },
      "id": 11,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "pluginVersion": "13.2.3",
      "targets": [{ "datasource": "${DS_LOKI}", "editorMode": "code", "expr": "{project=~\".+\"}", "queryType": "range", "refId": "A" }],
      "title": "Build container logs · Alloy to Loki",
      "type": "logs"
    },
    {
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 42 },
      "id": 12,
      "options": { "content": "**Log panel note:** This panel filters on PipeGuard’s `project` label. Loki currently responds to health checks, but no labels are ingested yet. It will populate after Alloy forwards logs from containers labeled with `pipeguard_project` and `pipeguard_build`.", "mode": "markdown" },
      "pluginVersion": "13.2.3",
      "title": "Log ingestion status",
      "type": "text"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["pipeguard", "jenkins", "prometheus", "loki", "vagrant"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PipeGuard - CI/CD & Observability",
  "uid": "pipeguard-observability",
  "version": 1,
  "weekStart": ""
}
