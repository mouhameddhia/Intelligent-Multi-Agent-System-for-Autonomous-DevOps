# Copy this file to .env and fill in your values.

# Your Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=your-groq-key-here

# Groq model to use
LLM_MODEL=openai/gpt-oss-120b

# Port this backend runs on (must be different from the main backend on 8000)
AGENT_PORT=8001

# Set to true to use synthetic data instead of real Jenkins/GitHub APIs
USE_SYNTHETIC=true
