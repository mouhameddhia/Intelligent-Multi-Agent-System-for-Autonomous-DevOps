        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "pods": {
          "items": {
            "$ref": "#/$defs/PodState"
          },
          "title": "Pods",
          "type": "array"
        },
        "previous_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Image"
        },
        "previous_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Revision"
        },
        "recent_events": {
          "items": {
            "type": "string"
          },
          "title": "Recent Events",
          "type": "array"
        },
        "replicas_desired": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replicas Desired"
        },
        "replicas_ready": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
