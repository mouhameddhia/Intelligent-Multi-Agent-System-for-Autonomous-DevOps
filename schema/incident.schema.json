{
  "$defs": {
    "ActionTarget": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "kind": {
          "description": "deployment | configmap | pipeline | repository | pod | ...",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        }
      },
      "required": [
        "kind",
        "name",
        "environment"
      ],
      "title": "ActionTarget",
      "type": "object"
    },
    "ActionType": {
      "enum": [
        "read",
        "diagnose",
        "propose",
        "rerun_pipeline",
        "restart",
        "rollback",
        "config_change",
        "pull_request",
        "scale",
        "delete_resource"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "AgentStep": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "llm_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Provider"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "running",
            "completed",
            "skipped",
            "failed",
            "waiting"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "agent"
      ],
      "title": "AgentStep",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "approver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approver"
        },
        "decision": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "not_required"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        }
      },
      "required": [
        "required",
        "decision"
      ],
      "title": "Approval",
      "type": "object"
    },
    "ChangeInfo": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "title": "Author",
          "type": "string"
        },
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "diff": {
          "default": "",
          "title": "Diff",
          "type": "string"
        },
        "files_changed": {
          "items": {
            "type": "string"
          },
          "title": "Files Changed",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "author",
        "message",
        "timestamp"
      ],
      "title": "ChangeInfo",
      "type": "object"
    },
    "DeploymentInfo": {
      "additionalProperties": false,
      "properties": {
        "current_revision": {
