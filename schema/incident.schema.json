        },
        "service": {
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "service",
        "environment"
      ],
      "title": "DeploymentInfo",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "log",
            "metric",
            "change",
            "k8s",
            "pipeline",
            "history",
            "quality"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "description": "Pointer into the incident, e.g. log:P03, metric:error_rate, change:abc123",
          "title": "Ref",
          "type": "string"
        },
        "weight": {
          "default": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "ref",
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "$ref": "#/$defs/ActionType"
        },
        "details": {
          "title": "Details",
          "type": "string"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "output": {
          "additionalProperties": true,
          "title": "Output",
          "type": "object"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "failed",
            "skipped"
          ],
