      "required": [
        "status",
        "action_type",
        "provider",
        "details",
        "executed_at"
      ],
      "title": "ExecutionResult",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "component": {
          "title": "Component",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
